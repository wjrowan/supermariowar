{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug smw (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/smw",
      "args": ["--datadir", "${workspaceFolder}/data"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build smw (debug)",
      "MIMode": "gdb",
      "stopAtEntry": false,
      "setupCommands": [
        { "description": "Pretty-print STL", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      "name": "Debug selected CMake target (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": ["--datadir", "${workspaceFolder}/data"],
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "stopAtEntry": false,
      "setupCommands": [
        { "description": "Pretty-print STL", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
